# Copy to .env.local and fill in. Never commit real secrets.

# Resend (https://resend.com) — API key + verified sender
RESEND_API_KEY=
# Trial: onboarding@resend.dev | Production: noreply@your-verified-domain.com
EMAIL_FROM=onboarding@resend.dev

# Public URL for password-reset and email-verification links
APP_URL=http://localhost:3000

# Optional: classic SMTP instead of Resend (omit RESEND_API_KEY to use SMTP only)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
