# Copy to .env.local (never commit .env.local). Set the same vars on Vercel → Settings → Environment Variables.

MONGODB_URI=
JWT_SECRET=

# OpenAI (chat completions + embeddings) — required for IEP generation, RAG embeddings, parse-pdf, etc.
OPENAI_API_KEY=

# Optional: app URL for emails / links
# NEXT_PUBLIC_APP_URL=http://localhost:3000
